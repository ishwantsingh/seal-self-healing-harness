# Copy to .env and fill values locally. Never commit a filled environment file.
# Use a NEW database: this repository has fresh Git history.
ATLAS_URI=
ATLAS_DATABASE=self_heal_review

# Tool-calling agent model; keep fixed across baseline/candidate comparisons.
OPENROUTER_API_KEY=
OPENROUTER_AGENT_MODEL=
# Required for evolution, not basic task runs.
OPENROUTER_EVOLUTION_MODEL=

# Optional for basic runs; enable and configure for evolution/selection.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=self-heal-review
# Optional for API keys belonging to multiple workspaces.
# LANGSMITH_WORKSPACE_ID=

# Build with: self-heal runner build
SELF_HEAL_RUNNER_IMAGE=self-heal-runner:local
